# Entrée de l'API pour les applications natives, sans barre finale (les chemins « /auth/login »,
# « /transport/sync » s'y ajoutent). Vide en développement : bureau simulé.
EXPO_PUBLIC_API_URL=

# Code d'application : « terrain » (défaut, noyau avec le module HSSEQ) ou « mobile » (noyau sans
# HSSEQ : Rotations seules, sous le code de Rotations web).
EXPO_PUBLIC_APP_CODE=

# Nom de l'environnement affiché sous le titre (« Recette ») ; vide en production.
EXPO_PUBLIC_ENVIRONMENT=
