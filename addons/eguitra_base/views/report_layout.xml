<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mise en page des documents (factures, lettres de relance, relevés) : le logo de la société à
         20 mm de haut avec 5 mm de vide avant l'adresse, comme l'exige la charte d'EGUITRA GROUP
         (espace libre autour du logo) ; le filet sous l'en-tête des tableaux à la couleur principale
         de la société quand elle en a une. L'en-tête est rendu à environ 85 % par wkhtmltopdf : on
         demande 24 mm et 6 mm pour obtenir 20 mm et 5 mm sur le PDF. -->
    <template id="external_layout_standard_eguitra" inherit_id="web.external_layout_standard">
        <xpath expr="//img[hasclass('o_company_logo_small')]" position="attributes">
            <attribute name="style">height: 24mm; max-height: 24mm; width: auto; max-width: none;</attribute>
        </xpath>
        <xpath expr="//img[hasclass('o_company_logo_small')]/.." position="attributes">
            <attribute name="style">margin-bottom: 6mm !important;</attribute>
        </xpath>
        <!-- Facture au modèle des sociétés (report_invoice.xml) : elle porte elle-même l'identité de la
             société (adresse, contacts, NIF, RCCM) ; l'en-tête garde le logo et le slogan. -->
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="t-if">not eguitra_document_header</attribute>
        </xpath>
        <!-- La classe de l'article est calculée (t-attf-class) : hasclass() ne la voit pas. -->
        <xpath expr="//div[contains(@t-attf-class, 'o_report_layout_standard')]" position="inside">
            <style t-if="company.primary_color">
                <t t-out="'.o_company_%s_layout table thead th { border-bottom: 1.5pt solid %s !important; }' % (company.id, company.primary_color)"/>
            </style>
        </xpath>
    </template>
</odoo>
