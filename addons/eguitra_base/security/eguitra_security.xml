<?xml version="1.0" encoding="utf-8"?>
<!--
    Profils de la plateforme (offre, chapitre 5.3). Chaque utilisateur reçoit un ou plusieurs
    profils ; les applications EGUITRA Finance, AxisPro Suite et le portail n'affichent que le
    périmètre correspondant. Les modules métier ajoutent leurs droits à ces groupes.
-->
<odoo>
    <record id="module_category_eguitra" model="ir.module.category">
        <field name="name">EGUITRA</field>
        <field name="sequence">1</field>
    </record>

    <record id="privilege_eguitra_profiles" model="res.groups.privilege">
        <field name="name">Profils de la plateforme</field>
        <field name="category_id" ref="module_category_eguitra"/>
        <field name="sequence">1</field>
    </record>

    <record id="group_profile_direction" model="res.groups">
        <field name="name">Direction générale</field>
        <field name="privilege_id" ref="privilege_eguitra_profiles"/>
        <field name="comment">Tableau de bord du dirigeant, pilotage, consolidation, dernier niveau d'approbation.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('account.group_account_readonly'))]"/>
    </record>

    <record id="group_profile_finance" model="res.groups">
        <field name="name">Finance et comptabilité</field>
        <field name="privilege_id" ref="privilege_eguitra_profiles"/>
        <field name="comment">Ventes, achats, trésorerie, immobilisations, budget, clôtures, états et déclarations.</field>
        <!-- Contact/Création : la finance tient les fiches des tiers et leurs comptes bancaires. -->
        <field name="implied_ids" eval="[
            Command.link(ref('base.group_user')),
            Command.link(ref('base.group_partner_manager')),
            Command.link(ref('account.group_account_manager')),
            Command.link(ref('account.group_account_user')),
        ]"/>
    </record>

    <record id="group_profile_achats" model="res.groups">
        <field name="name">Achats</field>
        <field name="privilege_id" ref="privilege_eguitra_profiles"/>
        <field name="comment">Engagements de dépense et devis, pièces d'achat et avoirs fournisseurs saisis par catégorie de dépense avec leurs justificatifs, soumission au circuit d'approbation, fiches des fournisseurs. Ni ventes, ni trésorerie, ni états, ni choix du compte.</field>
        <!--
            Facturation (account.group_account_invoice), comme le cabinet : créer, modifier et supprimer
            les pièces en brouillon, les comptabiliser quand le circuit le décide (pièce couverte par un
            engagement approuvé), créer l'immobilisation d'une catégorie d'investissement ; lecture des
            journaux, des taxes et des comptes. Ni Comptable (relevés, lettrage, paramétrage) ni
            Gestionnaire des contacts : les routes de l'API bornent la saisie aux pièces d'achat et aux
            avoirs fournisseurs, et la fiche d'un fournisseur aux champs d'identité.
        -->
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_profile_exploitation" model="res.groups">
        <field name="name">Exploitation transport</field>
        <field name="privilege_id" ref="privilege_eguitra_profiles"/>
        <field name="comment">Flotte, chauffeurs, routes et tarifs, rotations, rentabilité.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_profile_chantiers" model="res.groups">
        <field name="name">BTP</field>
        <field name="privilege_id" ref="privilege_eguitra_profiles"/>
        <field name="comment">BTP : chantiers, situations d'avancement, retenues de garantie.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_profile_immobilier" model="res.groups">
        <field name="name">Immobilier</field>
        <field name="privilege_id" ref="privilege_eguitra_profiles"/>
        <field name="comment">Biens, baux, loyers et quittancement, patrimoine.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_profile_cabinet" model="res.groups">
        <field name="name">Cabinet AxisPro</field>
        <field name="privilege_id" ref="privilege_eguitra_profiles"/>
        <field name="comment">Dossiers de projets, évaluations, data room, comités, rapports, facturation des prestations.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('account.group_account_invoice'))]"/>
    </record>

    <!--
        Associé du cabinet (décision du gérant du 22 octobre 2026, appliquée le 26) : un consultant de
        MB AxisPro Consulting qui, en plus, scelle la décision du comité, force le passage d'un gate et
        ouvre une nouvelle révision d'un dossier verrouillé, avec la direction et toujours à deux
        personnes au moins. Il porte le profil cabinet (droits des dossiers).
    -->
    <record id="group_profile_associe" model="res.groups">
        <field name="name">Associé du cabinet</field>
        <field name="privilege_id" ref="privilege_eguitra_profiles"/>
        <field name="comment">Consultant de MB AxisPro Consulting qui, en plus, scelle les décisions du comité, force le passage d'un gate et ouvre une nouvelle révision d'un dossier verrouillé (avec la direction, toujours à deux personnes au moins).</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('group_profile_cabinet'))]"/>
    </record>

    <record id="group_profile_rh" model="res.groups">
        <field name="name">Ressources humaines</field>
        <field name="privilege_id" ref="privilege_eguitra_profiles"/>
        <field name="comment">Salariés et dossiers du personnel, absences et congés, avances et prêts, paie et bulletins, déclarations sociales et fiscales, paramètres de paie.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_profile_hsseq" model="res.groups">
        <field name="name">Responsable HSSEQ</field>
        <field name="privilege_id" ref="privilege_eguitra_profiles"/>
        <field name="comment">Santé, sécurité, sûreté, environnement et qualité : classement des événements et enquêtes, plan d'actions, grilles de contrôle, seconde validation des dérogations au verrou de départ, réouverture des fiches closes. Seul profil à lire le détail des alcootests.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <!-- Conducteur : l'application de terrain NIMOVA Terrain seule (téléphone), aucune application web. -->
    <record id="group_profile_conducteur" model="res.groups">
        <field name="name">Conducteur</field>
        <field name="privilege_id" ref="privilege_eguitra_profiles"/>
        <field name="comment">NIMOVA Terrain seule, sur téléphone : contrôle pré-départ, alcootest et déclaration d'événement pour lui-même, lecture de ses propres saisies et de ses habilitations.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <!-- Auditeur (interne ou externe) : NIMOVA · HSSEQ en lecture seule, borné à des sites et à une date de
         fin d'accès portées par le compte (module HSSEQ). -->
    <record id="group_profile_auditeur" model="res.groups">
        <field name="name">Auditeur</field>
        <field name="privilege_id" ref="privilege_eguitra_profiles"/>
        <field name="comment">NIMOVA · HSSEQ en lecture seule, sur un périmètre (sites) et jusqu'à une date de fin d'accès : événements, actions, contrôles, risques, audits et exigences, sans les alcootests ni les données personnelles au-delà du nécessaire. Aucune écriture.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_profile_admin" model="res.groups">
        <field name="name">Administration</field>
        <field name="privilege_id" ref="privilege_eguitra_profiles"/>
        <field name="comment">Référentiels, seuils d'alerte, taux de change, profils et droits, journal d'audit.</field>
        <field name="implied_ids" eval="[
            Command.link(ref('group_profile_direction')),
            Command.link(ref('group_profile_finance')),
            Command.link(ref('base.group_erp_manager')),
            Command.link(ref('base.group_multi_company')),
        ]"/>
    </record>

    <!-- Porteur de projet : utilisateur du portail, sans accès interne. -->
    <record id="group_profile_porteur" model="res.groups">
        <field name="name">Porteur de projet</field>
        <field name="comment">Portail AxisPro : dépôt des pièces, suivi du dossier, échanges avec le cabinet.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_portal'))]"/>
    </record>
</odoo>
