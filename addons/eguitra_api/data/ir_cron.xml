<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_purge_tokens" model="ir.cron">
        <field name="name">EGUITRA : purge des jetons expirés</field>
        <field name="model_id" ref="model_eguitra_api_token"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- Chaque nuit à 02 h 30 (heure de Conakry, UTC), recalé à chaque mise à jour. -->
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:30:00')"/>
    </record>
    <record id="cron_purge_access_log" model="ir.cron">
        <field name="name">EGUITRA : purge des journaux d'accès de plus de 12 mois</field>
        <field name="model_id" ref="model_eguitra_api_access_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- Chaque nuit à 02 h 40 (heure de Conakry, UTC), recalé à chaque mise à jour. -->
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:40:00')"/>
    </record>
    <record id="cron_purge_login_attempts" model="ir.cron">
        <field name="name">EGUITRA : purge des tentatives de connexion</field>
        <field name="model_id" ref="model_eguitra_api_login_attempt"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- Chaque nuit à 02 h 50 (heure de Conakry, UTC), recalé à chaque mise à jour. -->
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:50:00')"/>
    </record>
</odoo>
