<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Relevé du propriétaire d'un ensemble routier. Les valeurs sont préparées et mises en forme par
         controllers/owners.py (statement_context) ; le gabarit ne fait que les disposer. -->

    <template id="report_owner_statement_document">
        <t t-call="web.external_layout">
            <t t-set="r" t-value="statement"/>
            <div class="page rl">
                <style>
                    .rl { font-family: "Helvetica Neue", Arial, sans-serif; font-size: 10pt; color: #1d2320; }
                    .rl h1 { font-size: 16pt; margin: 0 0 1mm 0; }
                    .rl h2 { font-size: 11.5pt; margin: 6mm 0 2mm 0; border-bottom: 1px solid #c9d3cf; padding-bottom: 1mm; }
                    .rl .muted { color: #5b6662; }
                    .rl .small { font-size: 8.5pt; }
                    .rl table { width: 100%; border-collapse: collapse; margin-bottom: 2mm; }
                    .rl th { background: #11221d; color: #fff; text-align: left; padding: 1.2mm 1.6mm; font-weight: 600; font-size: 9pt; }
                    .rl td { border-bottom: 1px solid #e3e8e6; padding: 1.2mm 1.6mm; vertical-align: top; }
                    .rl .num { text-align: right; white-space: nowrap; }
                    .rl .kv td:first-child { width: 40%; color: #5b6662; }
                    .rl .total td { font-weight: 700; border-top: 1.5px solid #11221d; }
                    .rl .result { border: 2px solid #11221d; padding: 3mm 4mm; margin: 4mm 0; }
                    .rl .result .v { font-size: 15pt; font-weight: 700; }
                    .rl .neg { color: #b3261e; }
                </style>
                <h1>Relevé du propriétaire</h1>
                <p class="muted small">Ensemble <t t-esc="r['vehicle']"/>, période <t t-esc="r['period']"/>.
                    Établi le <t t-esc="r['computed_at']"/>.</p>

                <table class="kv">
                    <tr t-foreach="r['header']" t-as="row"><td t-esc="row[0]"/><td t-esc="row[1]"/></tr>
                </table>

                <h2>Compte de l'ensemble</h2>
                <table>
                    <tr><th>Poste</th><th class="num">Montant</th></tr>
                    <tr t-foreach="r['account']" t-as="row" t-att-class="'total' if row[2] else None">
                        <td t-esc="row[0]"/><td class="num" t-esc="row[1]"/>
                    </tr>
                </table>
                <p class="muted small" t-esc="r['basis_note']"/>

                <t t-if="r['charges']">
                    <h2>Charges mensuelles de l'ensemble</h2>
                    <table>
                        <tr><th>Charge</th><th class="num">Mensuel</th><th class="num">Mois</th><th class="num">Montant</th></tr>
                        <tr t-foreach="r['charges']" t-as="row">
                            <td t-esc="row[0]"/><td class="num" t-esc="row[1]"/><td class="num" t-esc="row[2]"/><td class="num" t-esc="row[3]"/>
                        </tr>
                    </table>
                </t>

                <h2>Répartition</h2>
                <table>
                    <tr><th>Bénéficiaire</th><th>Base de calcul</th><th class="num">Montant</th></tr>
                    <tr t-foreach="r['shares']" t-as="row">
                        <td t-esc="row[0]"/><td t-esc="row[1]"/><td class="num" t-esc="row[2]"/>
                    </tr>
                </table>
                <div class="result">
                    <div class="muted small" t-esc="r['result_label']"/>
                    <div t-att-class="'v neg' if r['result_negative'] else 'v'" t-esc="r['result']"/>
                    <div class="small" t-esc="r['result_note']"/>
                </div>

                <h2>Rotations de la période</h2>
                <t t-if="r['rotations']">
                    <table>
                        <tr><th>Rotation</th><th>Chargement</th><th>Route</th><th>Client</th><th class="num">Livré (m³)</th>
                            <th class="num">Montant</th><th class="num">Frais déclarés</th></tr>
                        <tr t-foreach="r['rotations']" t-as="row">
                            <td t-esc="row[0]"/><td t-esc="row[1]"/><td t-esc="row[2]"/><td t-esc="row[3]"/>
                            <td class="num" t-esc="row[4]"/><td class="num" t-esc="row[5]"/><td class="num" t-esc="row[6]"/>
                        </tr>
                    </table>
                </t>
                <p t-else="" class="muted">Aucune rotation validée sur la période : les charges de l'ensemble restent à la charge du propriétaire.</p>
            </div>
        </t>
    </template>

    <template id="report_owner_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="eguitra_transport.report_owner_statement_document"/>
            </t>
        </t>
    </template>

    <record id="action_report_owner_statement" model="ir.actions.report">
        <field name="name">Relevé du propriétaire</field>
        <field name="model">eguitra.transport.owner.statement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">eguitra_transport.report_owner_statement</field>
        <field name="report_file">eguitra_transport.report_owner_statement</field>
    </record>
</odoo>
