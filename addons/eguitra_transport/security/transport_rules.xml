<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_vehicle_company" model="ir.rule">
        <field name="name">Ensembles routiers : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_transport_vehicle"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_driver_company" model="ir.rule">
        <field name="name">Chauffeurs : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_transport_driver"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_route_company" model="ir.rule">
        <field name="name">Routes : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_transport_route"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rotation_company" model="ir.rule">
        <field name="name">Rotations : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_transport_rotation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_product_company" model="ir.rule">
        <field name="name">Produits transportés : communs ou des sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_transport_product"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_tax_company" model="ir.rule">
        <field name="name">Taxes spécifiques : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_transport_tax"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rotation_tax_company" model="ir.rule">
        <field name="name">Taxes des rotations : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_transport_rotation_tax"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
