<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_vehicle_company" model="ir.rule">
        <field name="name">Ensembles routiers : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_transport_vehicle"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_driver_company" model="ir.rule">
        <field name="name">Chauffeurs : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_transport_driver"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_route_company" model="ir.rule">
