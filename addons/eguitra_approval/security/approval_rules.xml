<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_approval_rule_company" model="ir.rule">
        <field name="name">Règles d'approbation : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_approval_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_approval_request_company" model="ir.rule">
        <field name="name">Demandes d'approbation : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_approval_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_commitment_company" model="ir.rule">
        <field name="name">Engagements de dépense : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_commitment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
