<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_chantier_company" model="ir.rule">
        <field name="name">Chantiers : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_chantier"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_situation_company" model="ir.rule">
        <field name="name">Situations : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_chantier_situation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
