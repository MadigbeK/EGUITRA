<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lettre de relance : mise en page de la société (logo, couleurs du document, coordonnées), la même
         qu'aux factures ; jointe au courriel de relance et téléchargée pour l'envoi par courrier. -->
    <record id="action_report_reminder" model="ir.actions.report">
        <field name="name">Lettre de relance</field>
        <field name="model">eguitra.reminder</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">eguitra_finance.report_reminder</field>
        <field name="report_file">eguitra_finance.report_reminder</field>
        <field name="print_report_name">'Relance %s %s' % (object.partner_id.name, object.date.strftime('%d-%m-%Y'))</field>
    </record>

    <template id="report_reminder">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="lettre" t-value="o.letter()"/>
                    <t t-set="couleur" t-value="o.company_id.primary_color or '#373737'"/>
                    <div class="page">
                        <p class="text-end">Conakry, le <t t-esc="lettre['date'].strftime('%d/%m/%Y')"/></p>
                        <p class="text-end mb-4">
                            <strong t-esc="lettre['partner']"/>
                            <t t-foreach="lettre['partner_address']" t-as="ligne"><br/><t t-esc="ligne"/></t>
                        </p>
                        <p><strong>Objet : <t t-esc="lettre['object'][0].lower() + lettre['object'][1:]"/></strong></p>
                        <p>Madame, Monsieur,</p>
                        <p t-esc="lettre['intro']"/>
                        <table class="table table-sm">
                            <thead>
                                <!-- La couleur sur chaque cellule : celle de la ligne est recouverte par le tableau. -->
                                <t t-set="entete" t-value="'background-color: %s; color: #ffffff; padding: 4pt 6pt;' % couleur"/>
                                <tr>
                                    <th t-att-style="entete">Facture</th><th t-att-style="entete">Date</th>
                                    <th t-att-style="entete">Échéance</th>
                                    <th class="text-end" t-att-style="entete">Montant TTC</th>
                                    <th class="text-end" t-att-style="entete">Reste dû</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="lettre['invoices']" t-as="f">
                                    <td style="padding: 4pt 6pt;" t-esc="f['name']"/>
                                    <td style="padding: 4pt 6pt;" t-esc="f['date'] and f['date'].strftime('%d/%m/%Y') or ''"/>
                                    <td style="padding: 4pt 6pt;" t-esc="f['due'] and f['due'].strftime('%d/%m/%Y') or ''"/>
                                    <td class="text-end" style="padding: 4pt 6pt;" t-esc="o._montant(f['total'])"/>
                                    <td class="text-end" style="padding: 4pt 6pt;" t-esc="o._montant(f['residual'])"/>
                                </tr>
                            </tbody>
                        </table>
                        <p>Total échu : <strong t-attf-style="color: {{couleur}};" t-esc="o._montant(lettre['amount_due'])"/></p>
                        <p t-esc="lettre['closing']"/>
                        <p>Veuillez agréer, Madame, Monsieur, nos salutations distinguées.</p>
                        <p class="mt-5">La Direction financière<br/><t t-esc="lettre['company']"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
