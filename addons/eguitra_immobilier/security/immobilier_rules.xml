<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_property_company" model="ir.rule">
        <field name="name">Biens : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_property"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_lease_company" model="ir.rule">
        <field name="name">Baux : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_lease"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
