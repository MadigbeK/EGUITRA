        <field name="model_id" ref="model_eguitra_hsseq_event_cost"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hsseq_action_company" model="ir.rule">
        <field name="name">Actions HSSEQ : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_hsseq_action"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hsseq_action_reminder_company" model="ir.rule">
        <field name="name">Relances des actions : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_hsseq_action_reminder"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hsseq_check_company" model="ir.rule">
        <field name="name">Contrôles avant départ : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_hsseq_check"/>
