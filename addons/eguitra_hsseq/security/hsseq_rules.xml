    </record>
    <record id="rule_hsseq_nonconformity_company" model="ir.rule">
        <field name="name">Non-conformités : sociétés autorisées</field>
        <field name="model_id" ref="model_eguitra_hsseq_nonconformity"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hsseq_breath_test_company" model="ir.rule">
