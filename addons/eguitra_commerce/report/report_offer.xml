<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Corps commun des documents des achats et des ventes (offre, bon de commande), au gabarit des factures
        des sociétés (eguitra_base, views/report_invoice.xml) : mêmes blocs, même feuille de style, même charte.
        Les valeurs, déjà mises en forme, viennent de _eguitra_report_values (sale_order.py, purchase_order.py).
    -->
    <template id="document_body">
        <div class="page o_eg_invoice">
            <style t-out="d['css']"/>
            <div t-if="d['banner']" class="o_eg_banner" t-out="d['banner']"/>

            <table class="o_eg_head" name="eguitra_head">
                <tr>
                    <td style="width: 60%;">
                        <div class="o_eg_company_name" t-out="d['company_name']"/>
                        <div t-foreach="d['company_lines']" t-as="company_line" t-out="company_line"/>
                    </td>
                    <td class="o_eg_title">
                        <div class="o_eg_title_main" t-out="d['title']"/>
                        <div t-if="d['number']" class="o_eg_key">N° <t t-out="d['number']"/></div>
                        <div t-if="d['status']" class="o_eg_status" t-out="d['status']"/>
                        <div t-out="d['place_date']"/>
                    </td>
                </tr>
            </table>

            <table class="o_eg_parties" name="eguitra_parties">
                <tr>
                    <td style="width: 60%;">
                        <div class="o_eg_box">
                            <div class="o_eg_label" t-out="d['party_label']"/>
                            <div t-foreach="d['party']" t-as="item">
                                <span class="o_eg_key"><t t-out="item[0]"/> :</span> <t t-out="item[1]"/>
                            </div>
                        </div>
                    </td>
                    <td class="o_eg_refs">
                        <div t-foreach="d['references']" t-as="item">
                            <span class="o_eg_key"><t t-out="item[0]"/> :</span> <t t-out="item[1]"/>
                        </div>
                    </td>
                </tr>
            </table>

            <div t-if="d['object']" class="o_eg_object" name="eguitra_object">
                <span class="o_eg_key">Commentaire ou indication :</span> <t t-out="d['object']"/>
            </div>

            <table t-if="d['rows']" class="o_eg_lines" name="eguitra_main_lines">
                <t t-set="columns" t-value="5 + (1 if d['show_unit'] else 0) + (1 if d['show_discount'] else 0)"/>
                <thead>
                    <tr>
                        <th class="o_eg_num" style="width: 7%;">N°</th>
                        <th>Description</th>
                        <th t-if="d['show_unit']">Unité</th>
                        <th class="o_eg_num">Quantité</th>
                        <th class="o_eg_num" t-out="d['price_label']"/>
                        <th t-if="d['show_discount']" class="o_eg_num">Remise</th>
                        <th class="o_eg_num" t-out="d['amount_label']"/>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="d['rows']" t-as="row">
                        <tr t-if="row['kind'] == 'line'">
                            <td class="o_eg_num" t-out="row['number']"/>
                            <td class="o_eg_desc" t-out="row['name']"/>
                            <td t-if="d['show_unit']" t-out="row['unit']"/>
                            <td class="o_eg_num" t-out="row['quantity']"/>
                            <td class="o_eg_num" t-out="row['price']"/>
                            <td t-if="d['show_discount']" class="o_eg_num" t-out="row['discount']"/>
                            <td class="o_eg_num" t-out="row['amount']"/>
                        </tr>
                        <tr t-elif="row['kind'] == 'subtotal'" class="o_eg_subtotal">
                            <td t-att-colspan="columns - 1" class="o_eg_num" t-out="row['label']"/>
                            <td class="o_eg_num" t-out="row['amount']"/>
                        </tr>
                        <tr t-else="" t-att-class="'o_eg_%s' % row['kind']">
                            <td t-att-colspan="columns" class="o_eg_desc" t-out="row['label']"/>
                        </tr>
                    </t>
                </tbody>
            </table>

            <table class="o_eg_bottom" name="eguitra_totals">
                <tr>
                    <td class="o_eg_words" style="width: 55%;">
                        <div class="o_eg_key" t-out="d['words_intro']"/>
                        <div class="o_eg_accent" t-out="d['words']"/>
                    </td>
                    <td>
                        <table class="o_eg_totals">
                            <tr t-foreach="d['totals']" t-as="total" t-att-class="'o_eg_main' if total.get('main') else None">
                                <td t-out="total['label']"/>
                                <td class="o_eg_num" t-out="total['amount']"/>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <table class="o_eg_footer" name="eguitra_footer">
                <tr>
                    <td name="eguitra_terms">
                        <t t-set="terms" t-value="d['terms']"/>
                        <t t-if="terms and (terms.get('conditions') or terms.get('term') or terms.get('validity'))">
                            <div class="o_eg_key" t-out="d['terms_title']"/>
                            <div t-if="terms.get('validity')">Validité de l'offre : <t t-out="terms['validity']"/></div>
                            <div t-if="terms.get('term')">Conditions de règlement : <t t-out="terms['term']"/></div>
                            <div t-if="terms.get('conditions')" class="o_eg_desc" style="white-space: pre-line;" t-out="terms['conditions']"/>
                        </t>
                        <t t-if="d.get('approvers')">
                            <div class="o_eg_key" style="margin-top: 3mm;">APPROUVÉ PAR</div>
                            <div t-foreach="d['approvers']" t-as="approver" t-out="approver"/>
                        </t>
                    </td>
                    <td class="o_eg_sign" name="eguitra_signature">
                        <div class="o_eg_key" t-out="d['signatory']"/>
                        <div class="o_eg_sign_space"/>
                        <div class="o_eg_company_name" t-out="d['company_name']"/>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <!-- Offre commerciale (« OFFRE »), avec « Référence offre » et « Validité offre ». -->
    <record id="action_report_offer" model="ir.actions.report">
        <field name="name">Offre commerciale</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">eguitra_commerce.report_offer</field>
        <field name="report_file">eguitra_commerce.report_offer</field>
        <field name="print_report_name">'Offre %s' % (object.name or '').replace('/', '-')</field>
    </record>

    <template id="report_offer">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="eguitra_document_header" t-value="True"/>
                    <t t-set="d" t-value="o._eguitra_report_values()"/>
                    <t t-call="eguitra_commerce.document_body"/>
                </t>
            </t>
        </t>
    </template>
</odoo>
