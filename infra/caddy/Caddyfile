# Proxy d'entrée : TLS automatique (Let's Encrypt), en-têtes de sécurité, journal d'accès.
# Les domaines viennent de infra/.env (APEX_DOMAIN, WWW_DOMAIN, FINANCE_DOMAIN, AXISPRO_DOMAIN,
# PORTAIL_DOMAIN, RECETTE_DOMAIN, CORE_DOMAIN). Un domaine non renseigné prend un nom en .localhost, jamais
# joignable de l'extérieur : on peut ainsi ouvrir la recette avant la production.
# Seules les applications web sont publiques ; l'API du noyau ne l'est jamais (la passerelle Next
# l'appelle sur le réseau Docker) et le client web du noyau n'est ouvert qu'aux adresses ADMIN_IPS.
{
	email {$ACME_EMAIL}
	skip_install_trust
}

(commun) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-X-Powered-By
	}
	log {
		output file /data/logs/acces.log {
			roll_size 50MiB
			roll_keep 20
		}
	}
}

# Lien unique de la production : le nom nu du domaine sert toutes les applications (décision du gérant
# du 6 novembre 2026). Une seule connexion, puis l'accueil limité aux droits du compte.
{$APEX_DOMAIN:apex.localhost} {
	import commun
	request_body {
		max_size 25MB
	}
	# X-Real-IP est réécrit à chaque requête : la passerelle n'a confiance qu'en lui pour
	# connaître l'adresse du client (limitation des essais de connexion, journal des accès).
	reverse_proxy web:3000 {
		header_up X-Real-IP {remote_host}
	}
}

# www et anciennes adresses : renvoi vers le lien unique, chemin conservé (favoris, liens déjà diffusés).
# 302 : ces renvois ne se gravent pas dans les navigateurs.
{$WWW_DOMAIN:www.localhost}, {$FINANCE_DOMAIN:finance.localhost}, {$AXISPRO_DOMAIN:axispro.localhost} {
	import commun
	redir https://{$APEX_DOMAIN:apex.localhost}{uri} 302
}

# Ancienne adresse du portail : sa racine mène au portail, à la page de connexion du cabinet.
{$PORTAIL_DOMAIN:portail.localhost} {
	import commun
	redir / https://{$APEX_DOMAIN:apex.localhost}/portail 302
	redir https://{$APEX_DOMAIN:apex.localhost}{uri} 302
}

# Recette : mêmes applications, environnement d'essai séparé (base, noyau et cookies distincts).
{$RECETTE_DOMAIN:recette.localhost} {
	import commun
	request_body {
		max_size 25MB
	}
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy web-recette:3000 {
		header_up X-Real-IP {remote_host}
	}
}

# Noyau de production : administration technique seulement, depuis les adresses autorisées.
{$CORE_DOMAIN:noyau.localhost} {
	import commun
	@admin remote_ip {$ADMIN_IPS}
	handle @admin {
		reverse_proxy /websocket* odoo:8072
		reverse_proxy odoo:8069
	}
	handle {
		respond "Accès réservé." 403
	}
}
