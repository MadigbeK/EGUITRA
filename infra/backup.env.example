# Copier en infra/backup.env (jamais dans le dépôt) pour activer la copie hors site chiffrée.
# Les distants rclone se déclarent par variables d'environnement ; rien n'est écrit sur disque.
#
# 1. Stockage objet (exemple Backblaze B2 ; tout stockage compatible S3 convient aussi) :
RCLONE_CONFIG_OFFSITE_TYPE=b2
RCLONE_CONFIG_OFFSITE_ACCOUNT=identifiant-de-cle
RCLONE_CONFIG_OFFSITE_KEY=cle-applicative
#
# 2. Chiffrement côté serveur avant envoi (distant « crypt » posé sur le précédent).
#    Les deux mots de passe s'obscurcissent avec : docker run --rm rclone/rclone obscure 'mot-de-passe'
#    Les conserver aussi hors du serveur (coffre du gérant) : sans eux, les copies sont illisibles.
RCLONE_CONFIG_SECURE_TYPE=crypt
RCLONE_CONFIG_SECURE_REMOTE=offsite:nom-du-bucket/eguitra
RCLONE_CONFIG_SECURE_PASSWORD=mot-de-passe-obscurci
RCLONE_CONFIG_SECURE_PASSWORD2=sel-obscurci
#
# 3. Destination utilisée par les scripts (vide : sauvegardes seulement locales).
RCLONE_REMOTE=secure:
#
# Rétentions (jours) et heure de la sauvegarde de base.
BACKUP_RETENTION_DAYS=14
OFFSITE_RETENTION_DAYS=30
BACKUP_HOUR=01
