{
  email {$ACME_EMAIL}
}

# Applications EGUITRA Finance et AxisPro Suite : tout passe par le front Next.js,
# qui proxifie lui-même l'API. Le client web du noyau n'est ouvert qu'aux IP d'administration.
{$FINANCE_HOST}, {$AXISPRO_HOST}, {$RECETTE_HOST} {
  encode gzip

  @noyau {
    path /odoo* /web* /longpolling* /websocket*
  }
  @noyau_interdit {
    path /odoo* /web* /longpolling* /websocket*
    not remote_ip {$ADMIN_IPS}
  }
  respond @noyau_interdit 404
  handle @noyau {
    reverse_proxy odoo:8069
  }

  handle {
    reverse_proxy web:3000
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
  }
}
