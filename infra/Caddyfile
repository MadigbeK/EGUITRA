{
  email {$ACME_EMAIL}
}

# Surcouche EGUITRA Finance : fichiers statiques du front, API vers le noyau.
{$FINANCE_HOST}, {$AXISPRO_HOST}, {$RECETTE_HOST} {
  encode gzip

  @admin {
    path /web* /odoo* /website*
    not remote_ip {$ADMIN_IPS}
  }
  respond @admin 404

  handle /api/* {
    reverse_proxy odoo:8069
  }
  handle /longpolling/* {
    reverse_proxy odoo:8072
  }
  handle /web* {
    reverse_proxy odoo:8069
  }
  handle {
    root * /srv/frontend
    try_files {path} /index.html
    file_server
  }
}
