# Copier en infra/.env sur le serveur et remplacer chaque valeur.
# Générer les secrets avec : openssl rand -base64 33 | tr -d '/+='
# Production et recette n'ont aucun secret en commun.

# Production : grappe PostgreSQL (superutilisateur réservé aux sauvegardes et à l'administration),
# rôle applicatif du noyau (sans privilège de superutilisateur), mot de passe maître, base servie.
POSTGRES_USER=odoo
POSTGRES_PASSWORD=a-remplacer
ODOO_DB_USER=eguitra_app
ODOO_DB_PASSWORD=a-remplacer
ODOO_ADMIN_PASSWD=a-remplacer
ODOO_DB=eguitra

# Recette : grappe PostgreSQL distincte, mot de passe maître, base servie.
RECETTE_POSTGRES_PASSWORD=a-remplacer
RECETTE_ODOO_ADMIN_PASSWD=a-remplacer
RECETTE_DB=eguitra_recette

# Proxy d'entrée (profil « proxy ») : domaines publics, contact Let's Encrypt, adresses admin
# autorisées sur le client web du noyau (séparées par des espaces, notation CIDR).
ACME_EMAIL=contact@exemple.com
FINANCE_DOMAIN=finance.exemple.com
AXISPRO_DOMAIN=axispro.exemple.com
PORTAIL_DOMAIN=portail.exemple.com
RECETTE_DOMAIN=recette.exemple.com
CORE_DOMAIN=noyau.exemple.com
# Nom nu et www : renvoyés vers FINANCE_DOMAIN (infra/domaines.sh les inscrit).
APEX_DOMAIN=exemple.com
WWW_DOMAIN=www.exemple.com
ADMIN_IPS=203.0.113.10/32
# Répertoire des sauvegardes sur le serveur (voir infra/backup/README.md).
BACKUP_DIR=/srv/eguitra/backup
# Supervision (monitor.sh) : destinations des alertes, facultatives. Webhook JSON {"text": ...}
# (Slack, Teams, Google Chat) et/ou sujet ntfy (https://ntfy.sh/un-sujet-secret).
ALERT_WEBHOOK_URL=
ALERT_NTFY_URL=
# Sonde externe de disponibilité (par exemple healthchecks.io) : adresse appelée à chaque contrôle
# réussi ; le service externe alerte s'il ne reçoit plus de signal (serveur arrêté, réseau coupé).
HEARTBEAT_URL=
# Serveur d'envoi de courriel (relances des clients) : infra/mail-server.sh production|recette.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=finance@exemple.com
# Service client (eguitra_service_client) : une boîte de courriel par société, relevée en IMAP sur TLS (993),
# et WhatsApp (API Cloud de Meta). Vides : canaux inactifs. Jamais en base, jamais dans le dépôt.
# SC_MAIL_AUTHSERV_ID : identifiant (authserv-id) du serveur de réception dans l'en-tête Authentication-Results ;
# lui seul est cru pour reconnaître un expéditeur (le serveur doit retirer les en-têtes qui le prétendent).
SC_IMAP_HOST=
SC_IMAP_PORT=993
SC_IMAP_GROUPE_USER=
SC_IMAP_GROUPE_PASSWORD=
SC_IMAP_CABINET_USER=
SC_IMAP_CABINET_PASSWORD=
SC_MAIL_AUTHSERV_ID=
# WhatsApp : jeton d'accès permanent (utilisateur système du compte Meta Business vérifié), secret de
# l'application (signature des notifications), jeton de vérification choisi pour l'adresse de notification
# (https://<site>/api/whatsapp/webhook), identifiant du numéro de chaque société, version de l'API Graph.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GROUPE_PHONE_NUMBER_ID=
WHATSAPP_CABINET_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
# Recette : mêmes variables préfixées RECETTE_ (boîtes et numéro de test distincts de la production).
RECETTE_SC_IMAP_HOST=
RECETTE_SC_IMAP_PORT=993
RECETTE_SC_IMAP_GROUPE_USER=
RECETTE_SC_IMAP_GROUPE_PASSWORD=
RECETTE_SC_IMAP_CABINET_USER=
RECETTE_SC_IMAP_CABINET_PASSWORD=
RECETTE_SC_MAIL_AUTHSERV_ID=
RECETTE_WHATSAPP_ACCESS_TOKEN=
RECETTE_WHATSAPP_APP_SECRET=
RECETTE_WHATSAPP_VERIFY_TOKEN=
RECETTE_WHATSAPP_GROUPE_PHONE_NUMBER_ID=
RECETTE_WHATSAPP_CABINET_PHONE_NUMBER_ID=
RECETTE_WHATSAPP_API_VERSION=v22.0
# Lecture des business plans par l'IA (AxisPro, ouverture d'un dossier) : clé de l'API d'Anthropic
# (console.anthropic.com, facturée à l'usage). Vide : lecture indisponible, saisie à la main. Le modèle se
# change par AXISPRO_IA_MODELE (Claude Opus 5.5 par défaut). Recette : clé distincte, préfixe RECETTE_.
ANTHROPIC_API_KEY=
AXISPRO_IA_MODELE=
RECETTE_ANTHROPIC_API_KEY=
RECETTE_AXISPRO_IA_MODELE=
