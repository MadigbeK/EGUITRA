# Copier en infra/.env sur le serveur et remplacer chaque valeur.
# Générer les secrets avec : openssl rand -base64 33 | tr -d '/+='
# Production et recette n'ont aucun secret en commun.

# Production : grappe PostgreSQL (superutilisateur réservé aux sauvegardes et à l'administration),
# rôle applicatif du noyau (sans privilège de superutilisateur), mot de passe maître, base servie.
POSTGRES_USER=odoo
POSTGRES_PASSWORD=a-remplacer
ODOO_DB_USER=eguitra_app
ODOO_DB_PASSWORD=a-remplacer
ODOO_ADMIN_PASSWD=a-remplacer
ODOO_DB=eguitra

# Recette : grappe PostgreSQL distincte, mot de passe maître, base servie.
RECETTE_POSTGRES_PASSWORD=a-remplacer
RECETTE_ODOO_ADMIN_PASSWD=a-remplacer
RECETTE_DB=eguitra_recette

# Proxy d'entrée (profil « proxy ») : domaines publics, contact Let's Encrypt, adresses admin
# autorisées sur le client web du noyau (séparées par des espaces, notation CIDR).
ACME_EMAIL=contact@exemple.com
FINANCE_DOMAIN=finance.exemple.com
AXISPRO_DOMAIN=axispro.exemple.com
PORTAIL_DOMAIN=portail.exemple.com
RECETTE_DOMAIN=recette.exemple.com
CORE_DOMAIN=noyau.exemple.com
ADMIN_IPS=203.0.113.10/32
# Répertoire des sauvegardes sur le serveur (voir infra/backup/README.md).
BACKUP_DIR=/srv/eguitra/backup
# Supervision (monitor.sh) : destinations des alertes, facultatives. Webhook JSON {"text": ...}
# (Slack, Teams, Google Chat) et/ou sujet ntfy (https://ntfy.sh/un-sujet-secret).
ALERT_WEBHOOK_URL=
ALERT_NTFY_URL=
# Sonde externe de disponibilité (par exemple healthchecks.io) : adresse appelée à chaque contrôle
# réussi ; le service externe alerte s'il ne reçoit plus de signal (serveur arrêté, réseau coupé).
HEARTBEAT_URL=
# Serveur d'envoi de courriel (relances des clients) : infra/mail-server.sh production|recette.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=finance@exemple.com
