# Copier en infra/.env sur le serveur et remplacer chaque valeur.
# Générer les secrets avec : openssl rand -base64 33
POSTGRES_USER=odoo
POSTGRES_PASSWORD=a-remplacer
ODOO_ADMIN_PASSWD=a-remplacer
# Base servie par ce noyau (eguitra_recette en recette, eguitra en production).
ODOO_DB=eguitra_recette
