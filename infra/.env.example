# Copier en .env et renseigner. Ne jamais committer .env.
ODOO_VERSION=18.0
DOMAIN=eguitragroup.com
FINANCE_HOST=finance.eguitragroup.com
AXISPRO_HOST=axispro.mbaxisproconsulting.com
RECETTE_HOST=recette.eguitragroup.com
ADMIN_IPS=1.2.3.4/32            # adresses autorisées à ouvrir le client web du noyau
ACME_EMAIL=emkouyate@e-volutionxp.com

POSTGRES_USER=odoo
POSTGRES_PASSWORD=changez-moi-32-caracteres
POSTGRES_DB=postgres
ODOO_ADMIN_PASSWD=changez-moi-aussi

# Sauvegardes hors site (rclone), ex. Backblaze B2
RCLONE_REMOTE=b2:eguitra-backups
BACKUP_PASSPHRASE=phrase-de-chiffrement-longue

# ---- Plateforme (API FastAPI + web Next.js) ----
APP_ENV=production
JWT_SECRET=                      # openssl rand -hex 64
CORS_ORIGINS=https://finance.eguitragroup.com,https://axispro.mbaxisproconsulting.com
PG_PLATFORM_DB=eguitra_platform
PG_PLATFORM_USER=eguitra
PG_PLATFORM_PASSWORD=changez-moi
PG_ODOO_DB=eguitra
PG_ODOO_USER=eguitra_readonly
PG_ODOO_PASSWORD=changez-moi
ODOO_DB=eguitra
ODOO_API_USER=eguitra_bot
ODOO_API_KEY=                    # clé API du compte eguitra_bot dans le noyau
REDIS_URL=redis://redis:6379/0
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://finance.eguitragroup.com
